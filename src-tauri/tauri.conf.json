{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Studio",
  "version": "0.9.15",
  "identifier": "io.github.moresyl.dshstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:* http://localhost:*",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist": "dist/"
    },
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform DeepSeek Harness desktop studio",
    "longDescription": "A native Rust and Tauri studio for DeepSeek Harness with supervised local runtime, isolated profiles, terminals, session search and export, plugin catalog and recovery, remote access, diagnostics, and signed updates for Windows, macOS, and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dshpreset"],
        "name": "DSH Agent Preset",
        "description": "Portable DSH Agent Preset package",
        "role": "Editor",
        "mimeType": "application/vnd.dsh.agent-preset+zip",
        "exportedType": {
          "identifier": "io.github.moresyl.dshstudio.agent-preset",
          "conformsTo": ["public.zip-archive"]
        }
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dsh"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRDlBREQ4RTA3QTY4N0EKUldSNmFIcmcySzNaNnhad3M2bnBqWFVVYjNMZThvTUdhQU1Odnl0dTdNNFNobWs2NXNMdnViZ3oK",
      "endpoints": [
        "https://github.com/Moresyl/dsh-studio/releases/latest/download/latest.json",
        "https://moresyl.github.io/dsh-studio/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
