{
  "name": "dsh-studio",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Native desktop studio for DeepSeek Harness — Linux/macOS/Windows, built with Rust + Tauri",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "tauri",
    "rust",
    "desktop",
    "supervisor",
    "cross-platform",
    "nodejs",
    "terminal",
    "plugin-marketplace",
    "developer-tools"
  ],
  "homepage": "https://github.com/Moresyl/dsh-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moresyl/dsh-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Moresyl/dsh-studio/issues"
  },
  "author": "Moresyl",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node .github/scripts/verify-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src media website packaging .github",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --workspace --json --output-path src-tauri/target/llvm-cov.json && node .github/scripts/verify-rust-coverage.mjs",
    "verify:contracts": "node .github/scripts/verify-public-contracts.mjs",
    "verify:a11y": "node .github/scripts/verify-accessibility.mjs",
    "verify:docs": "node .github/scripts/verify-bilingual-docs.mjs",
    "test:packaging": "node --test .github/scripts/*.test.mjs",
    "test:release": "node .github/scripts/release-notes.mjs && pnpm verify:contracts && pnpm verify:a11y && pnpm verify:docs && pnpm build && pnpm test:packaging && cargo test --manifest-path src-tauri/Cargo.toml --workspace && pnpm lint && pnpm test:coverage",
    "bundle:local": "tauri build --no-sign",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "semver": "^7.8.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.30.2"
}
